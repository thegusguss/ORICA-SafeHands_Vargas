<?xml version="1.0" encoding="utf-8" ?>
<!-- Copie este archivo como "conexion.config" (en la misma carpeta) y pegue su cadena de Azure.
     conexion.config NO se sube a git: cada uno tiene el suyo con su contraseña.
     Cadena: portal de Azure > su base > Cadenas de conexión > ADO.NET (autenticación SQL). -->
<appSettings>
  <add key="CadenaAzure"
       value="Server=tcp:SU-SERVIDOR.database.windows.net,1433;Initial Catalog=ORICA_SafeHandsDB;User ID=SU-USUARIO;Password=SU-CONTRASEÑA;Encrypt=True;TrustServerCertificate=False;Connection Timeout=10;" />
</appSettings>
