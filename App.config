<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<connectionStrings>
		<add name="ORICA_SafeHandsDB"
			 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=ORICA_SafeHandsDB;Integrated Security=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<startup useLegacyV2RuntimeActivationPolicy="true">
		<supportedRuntime version="v4.0"
						  sku=".NETFramework,Version=v4.7.2" />
	</startup>

</configuration>