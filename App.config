<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<!-- La cadena de Azure va en conexion.config (no se sube a git). Copiar conexion.ejemplo.config,
	     renombrarlo a conexion.config y pegar la cadena. Si el archivo no existe, se trabaja solo en local. -->
	<appSettings file="conexion.config" />

	<connectionStrings>
		<!-- Copia local (LocalDB): se usa sin internet. -->
		<add name="ORICA_SafeHandsDB"
			 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=ORICA_SafeHandsDB;Integrated Security=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<startup useLegacyV2RuntimeActivationPolicy="true">
		<supportedRuntime version="v4.0"
						  sku=".NETFramework,Version=v4.7.2" />
	</startup>

</configuration>